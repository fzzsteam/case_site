NEXT_PUBLIC_SITE_URL=https://example.com
OSS_REGION=oss-cn-guangzhou
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

MYSQL_URL=mysql://root:your-mysql-password@127.0.0.1:3306/case_site

SESSION_SECRET=change-me-to-a-long-random-string

# 以下四个变量都配置了才会启用 HTTPS 证书自动续签（ALB 监听证书），本地开发不需要配置。
# ALIYUN_ACCESS_KEY_ID/SECRET 需要有：云解析 DNS 读写权限（供 Let's Encrypt DNS-01 校验）、
# 数字证书管理服务（CAS）证书上传/删除权限、ALB UpdateListenerAttribute/GetListenerAttribute 权限。
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALB_REGION_ID=cn-shenzhen
# ALB_LISTENER_ID=lsn-xxxxxxxx
