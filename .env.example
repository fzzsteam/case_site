NEXT_PUBLIC_SITE_URL=https://example.com
OSS_REGION=oss-cn-guangzhou
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret

MYSQL_URL=mysql://root:your-mysql-password@127.0.0.1:3306/case_site

SESSION_SECRET=change-me-to-a-long-random-string

# 以下变量配置了才会启用 HTTPS 证书自动续签，本地开发不需要配置。
# 如果域名是通过 SAE 的"网关路由"（本质就是 Ingress）转发到 ALB 的，证书必须通过 SAE 的
# Ingress 接口更新，不能直接改 ALB 监听器——那样会被 SAE 的自动同步逻辑无预警覆盖回去。
# ALIYUN_ACCESS_KEY_ID/SECRET 需要有：云解析 DNS 读写权限（AliyunDNSFullAccess，供 Let's
# Encrypt DNS-01 校验）、数字证书管理服务证书上传/删除权限（AliyunYundunCertFullAccess）、
# SAE 权限（AliyunSAEFullAccess，用于更新网关路由绑定的证书）。
# ALIYUN_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_ACCESS_KEY_SECRET=your-access-key-secret
# ALB_REGION_ID=cn-shenzhen
# ALB_INSTANCE_ID=alb-xxxxxxxxxxxxxxxxxx
# 可选，SAE 命名空间 ID，默认等于 ALB_REGION_ID（默认命名空间）
# SAE_NAMESPACE_ID=cn-shenzhen
# 可选，网关路由监听端口，默认 443
# ALB_LISTENER_PORT=443
